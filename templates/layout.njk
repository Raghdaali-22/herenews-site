  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/favicon.png"><link rel="stylesheet" href="/assets/styles.css">
  <script src="/assets/ads.js" defer></script>
  <script src="/assets/smart.js" defer></script><script src="/assets/local.js" defer></script><script src="/assets/track.js" defer></script><script src="/assets/donate.js" defer></script><script src="/assets/finder.js" defer></script>
  <title>{% if fullTitle %}{{ fullTitle | escape }}{% else %}{{ title | default("Publications") | escape }} — Here News{% endif %}</title>
  {%- set metaDescription = description | default('Independent reporting, documentaries and audio from Here News.') %}
  {%- set canonical = page.url | absoluteUrl(site.url) %}
  {%- set shareImage = (ogImage or '/favicon.png') | absoluteUrl(site.url) %}
  <meta name="description" content="{{ metaDescription | escape }}">
  <link rel="canonical" href="{{ canonical }}">
  <link rel="alternate" type="application/atom+xml" title="Here News" href="/feed.xml">
  <meta property="og:site_name" content="Here News">
  <meta property="og:type" content="{{ ogType | default('website') }}">
  <meta property="og:title" content="{{ title | default('Publications') | escape }}">
  <meta property="og:description" content="{{ metaDescription | escape }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ shareImage }}">
  <meta name="twitter:card" content="{% if ogImage %}summary_large_image{% else %}summary{% endif %}">
  {%- if ogType == 'article' %}
  <meta property="article:published_time" content="{{ published }}">
  {%- if section %}<meta property="article:section" content="{{ section | escape }}">{% endif %}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"NewsArticle","headline":{{ title | json | safe }},"description":{{ metaDescription | json | safe }},"datePublished":{{ published | json | safe }},"inLanguage":{{ ('ar' if pageLang == 'ar' else 'en') | json | safe }},"mainEntityOfPage":{{ canonical | json | safe }},"image":[{{ shareImage | json | safe }}],"author":[{"@type":"Person","name":{{ author | json | safe }}{% if author | authorUrl %},"url":{{ (author | authorUrl | absoluteUrl(site.url)) | json | safe }},"sameAs":{{ author | authorSameAs | json | safe }}{% endif %}}],"publisher":{"@type":"Organization","name":"Here News","url":"https://herenews.net/","logo":{"@type":"ImageObject","url":"https://herenews.net/favicon.png"}}}</script>
  {%- endif %}
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MR3QKXB9"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
<header><div class="container nav"><a class="brand" href="/" aria-label="Here News home">Here News</a>
<nav class="navlinks" aria-label="Primary navigation">{% set onPubs = page.url == '/' or page.url.startsWith('/publications/') %}<a{% if onPubs %} class="active"{% endif %} href="/">Publications</a><a href="/here-news-project.html">Here News Project</a><a href="/about.html">About Us</a><a href="/project.html">Scientific Project</a><a href="/admin/" target="_blank" rel="noopener">Editorial Login</a></nav></div></header>
<main class="container publication-main">{{ content | safe }}</main>
<footer><div class="container footerGrid"><div>© Here News</div><div><a href="/">Publications</a> · <a href="/here-news-project.html">Here News Project</a> · <a href="/about.html">About</a> · <a href="/privacy.html">Privacy</a></div></div></footer>
<!-- Thigmo Donation Widget (Modal) -->
<script src="https://thigmos.com/embed/donations-widget.js"
  data-business-id="q8x8aobosphl9izussyvd0vi8"
  data-max-plans="3"
  data-layout="modal"
  data-theme="light"
  data-primary-color="#1e1d1c"
  data-accent-color="#f5f2e8"
  data-show-descriptions="true"
  data-show-custom-amounts="true"
  data-show-recurring="true"
  data-modal-button-text="Donate Now"
  data-modal-position="bottom-right"></script>
<!-- End Thigmo Donation Widget -->
</body></html>
