---
layout: layout.njk
pagination:
  data: collections.documentaries
  size: 1
  alias: post
  addAllPagesToCollections: false
permalink: "/publications/documentaries/{{ post | pubSlug }}/index.html"
eleventyComputed:
  title: "{{ post.data.title }}"
  description: "{{ post.data.subtitle or post.data.description }}"
---
{%- set d = post.data %}
{%- set lang = d | pubLang %}
<article class="publication-article lang-{{ lang }}"{% if lang == 'ar' %} lang="ar" dir="rtl"{% elif lang == 'en' %} lang="en"{% endif %}>
  {% include "item-header.njk" %}
  {% if d.video_url %}{% set embed = d.video_url | videoEmbed %}
    {% if embed %}<div class="video-frame"><iframe src="{{ embed }}" title="{{ d.title | escape }}" loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe></div>
    {% elif d.image %}<img class="publication-cover" src="{{ d.image | escape }}" alt="">{% endif %}
  {% elif d.image %}<img class="publication-cover" src="{{ d.image | escape }}" alt="">{% endif %}
  {% for para in d.description | default('') | paragraphs %}<p class="lede">{{ para | escape }}</p>{% endfor %}
  {% if d.video_url %}<p><a class="btn" href="{{ d.video_url | escape }}" target="_blank" rel="noopener noreferrer">Watch video ↗</a></p>{% endif %}
  <div class="publication-body">{{ post.templateContent | safe }}</div>
  {% include "item-tags.njk" %}
</article>
