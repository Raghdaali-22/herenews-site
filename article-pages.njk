---
layout: layout.njk
pagination:
  data: collections.articles
  size: 1
  alias: post
  addAllPagesToCollections: false
permalink: "publications/articles/{{ post.fileSlug | slugify }}/index.html"
eleventyComputed:
  title: "{{ post.data.title }}"
  description: "{{ post.data.description }}"
---

<article class="publication-article">

  <p>
    <a href="/publications/">← All publications</a>
  </p>

  <p class="small">
    Article · {{ post.data.date | shortDate }}
  </p>

  <h1>{{ post.data.title | escape }}</h1>

  <p class="small">
    By {{ post.data.author | default('Here News') | escape }}
  </p>

  {% if post.data.image %}
    <div class="publication-cover-wrapper cover-{{ post.data.image_size | default('medium') }}">
      <img
        class="publication-cover"
        src="{{ post.data.image | escape }}"
        alt="{{ post.data.title | escape }}"
      >
    </div>
  {% endif %}

  {% if post.data.description %}
    <p class="lede">{{ post.data.description | escape }}</p>
  {% endif %}

  <div class="publication-body">
    {{ post.templateContent | safe }}
  </div>

</article>
