---
layout: layout.njk
pagination:
  data: collections.audio
  size: 1
  alias: post
  addAllPagesToCollections: false
permalink: "/publications/audio/{{ post | pubSlug }}/index.html"
eleventyComputed:
  title: "{{ post.data.title }}"
  description: "{{ post.data.subtitle or post.data.description }}"
---
{%- set d = post.data %}
{%- set lang = d | pubLang %}
{%- set audioSrc = d.audio_url or d.external_audio_url %}
<article class="publication-article lang-{{ lang }}"{% if lang == 'ar' %} lang="ar" dir="rtl"{% elif lang == 'en' %} lang="en"{% endif %}>
  {% include "item-header.njk" %}

  {% if d.image %}
    <div class="publication-cover-wrapper cover-medium">
      <img class="publication-cover" src="{{ d.image | escape }}" alt="{{ d.title | escape }}">
    </div>
  {% endif %}

  {% for para in d.description | default('') | paragraphs %}<p class="lede">{{ para | escape }}</p>{% endfor %}

  {% if audioSrc %}
    <section class="audio-player-section">
      <h2>Listen to this recording</h2>
      <audio controls preload="metadata">
        <source src="{{ audioSrc | escape }}" type="audio/mpeg">
        Your browser does not support HTML audio.
      </audio>
      <p class="small">
        <a href="{{ audioSrc | escape }}" target="_blank" rel="noopener noreferrer">Open audio file ↗</a>
      </p>
    </section>
  {% endif %}

  <div class="publication-body">{{ post.templateContent | safe }}</div>
  {% include "item-tags.njk" %}
</article>
